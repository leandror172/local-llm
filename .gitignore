# Local/sensitive data (not tracked in git)
.claude/local/

# Claude Code project settings (may contain permissions, hooks, allowed tools — machine-specific)
# Patterns are `**/`-prefixed on purpose: a slash-bearing pattern is anchored to this
# directory, so the bare `.claude/settings.json` form silently missed nested copies
# (e.g. benchmarks/.claude/settings.json), which then showed up as untracked noise.
**/.claude/settings.json
**/.claude/settings.local.json
# Cozempic guard daemon lockfile (ephemeral, process-local)
**/.claude/.cozempic-init.lock

# Session logs may contain sensitive paths or system details
# Keep current session log tracked, archive older ones to local/ if sensitive
# .claude/session-log-*.md  # Uncomment if you want to exclude archived logs

# OS generated files
.DS_Store
Thumbs.db

# Conversation exports (large, raw session data — useful content is in session handoffs)
2026-*.txt

# Temporary files
*.tmp
*.bak

# Ephemeral logs and scratch data (downloads, benchmarks, test runs)
tmp/

# Benchmark results (large JSON + generated HTML, regenerated on each run)
benchmarks/results/

# Node.js dependencies (Puppeteer for HTML validation)
benchmarks/node_modules/

# Synced context files for portfolio chatbot (derived by sync-context.sh, uploaded to HF separately)
docs/portfolio/hf-space/context/*.md

# Python bytecode cache
__pycache__/

# LTG retrieval artifacts (binary index + transient embedding output)
# Keep tracked: ltg/probes/*.md, ltg/runs/embed-*.jsonl, retrieval/runs/store-*.jsonl
ltg/index/
ltg/index.bak*/
ltg/embeddings.jsonl

# LTG refresh wrapper — verbatim copy of the engine repo's script (T-106); keep untracked
# so it stays a cheap cp-resync, not a fork. Re-sync:
#   cp -p /mnt/i/workspaces/latent-topic-graph/run-refresh.sh ltg/
ltg/run-refresh.sh

# Environment variables (API keys, secrets)
.env
# Aider working files (chat history, cache, tags — not config)
.aider.tags.cache.v0/
.aider.chat.history.md
.aider.input.history
.idea/.gitignore
.idea/llm.iml
.idea/misc.xml
.idea/modules.xml
.idea/vcs.xml
.idea/inspectionProfiles/profiles_settings.xml

docs/plans/verdict-numeric-migration.md
docs/plans/verdict-numeric-migration-report.md

.idea/
ltg/.venv/

# LTG large embedding output (48M+, regenerable from extraction via run-embed.sh)
ltg/runs/*-embeddings.jsonl
