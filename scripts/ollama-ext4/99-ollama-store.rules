# 99-ollama-store.rules — T-68 self-healing store attach (Option A)
#
# When the dedicated ext4 vhd (attached from Windows at logon by
# wsl --mount --vhd) appears inside the WSL2 VM, tell systemd to pull in the
# recovery service. That service starts ollama, which (via Requires= the mount,
# which Requires= this device) brings the whole store online — no dependence on
# Windows-side command timing.
#
# Matched on the filesystem UUID so it survives the /dev/sdX letter changing.
# Install to /etc/udev/rules.d/ then: udevadm control --reload
ACTION=="add", SUBSYSTEM=="block", ENV{ID_FS_UUID}=="1704abd8-0c46-4f0c-bb3d-f749ca61eee8", TAG+="systemd", ENV{SYSTEMD_WANTS}+="ollama-store-recover.service"
