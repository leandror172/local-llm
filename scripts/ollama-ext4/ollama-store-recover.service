[Unit]
Description=Bring the ollama ext4 store + service online once the vhd device appears (T-68)
# Triggered by 99-ollama-store.rules (SYSTEMD_WANTS) on device 'add'. Ordered by
# the dependency cascade: start ollama -> Requires= the mount -> Requires= the
# (now-present) device. No explicit After= needed; the device is active when this
# service is wanted.

[Service]
Type=oneshot
# The boot-time attempt likely left the mount and/or ollama in 'failed' state
# (device wasn't attached yet). Clear that so the dependency jobs can run fresh...
ExecStart=/usr/bin/systemctl reset-failed
# ...then start ollama, which pulls the mount, which pulls the device.
# 'start' (not 'restart') is a no-op if ollama is already healthy -> idempotent
# if the device re-appears while everything is already up.
ExecStart=/usr/bin/systemctl start ollama.service
